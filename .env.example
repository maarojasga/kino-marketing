# API key de Google AI Studio (https://aistudio.google.com/apikey)
# Obligatoria: se usa para todo — generación de imágenes, skill y análisis del manual de marca
GEMINI_API_KEY=

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000

# Modelo de imagen (opcional). Por defecto: gemini-3-pro-image-preview
# ("Nano Banana Pro") — la mejor calidad y el mejor renderizado de texto.
# Alternativa más rápida/económica: gemini-3.1-flash-image-preview
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Resolución de imagen: 1K, 2K (por defecto) o 4K.
# 1K y 2K cuestan igual — 2K da más calidad sin costo extra. 4K sí cuesta más.
# GEMINI_IMAGE_SIZE=2K

# Modelo de texto usado por la skill y el análisis del manual (opcional)
# GEMINI_TEXT_MODEL=gemini-2.5-flash
