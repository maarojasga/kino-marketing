# API key de Google AI Studio (https://aistudio.google.com/apikey)
# Obligatoria: se usa para generar las imágenes (modelo gemini-2.5-flash-image)
GEMINI_API_KEY=

# API key de Anthropic (https://platform.claude.com/)
# Opcional: activa la mejora automática de prompts con Claude
ANTHROPIC_API_KEY=

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000

# Modelo de imagen alternativo (opcional)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
